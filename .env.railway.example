# =============================================================================
# CityShield — Railway environment variables (reference)
# =============================================================================
# These are NOT loaded automatically. Railway has no .env file — you set each
# variable in the dashboard under each service's "Variables" tab (or paste the
# block via "Raw Editor"). Values like ${{service.VAR}} are Railway *reference
# variables*: type them exactly as shown and Railway resolves them at deploy time.
#
# Service names below assume you named your Railway services:
#   opensearch, backend, frontend, traffic-sim, iot-sim, network-emulator,
#   detection-engine, response-manager, scenario-runner
# If you name them differently, update the references accordingly.
# =============================================================================


# ----- Shared secret you must generate yourself --------------------------------
# Generate with:  openssl rand -hex 32
# Set the SAME value on: backend (BACKEND_JWT_SECRET).
# Set the SAME OpenSearch creds on every service that talks to OpenSearch.
#   BACKEND_JWT_SECRET=<paste output of: openssl rand -hex 32>


# =============================================================================
# Service: opensearch   (Docker image / wrapper — NO public domain!)
# =============================================================================
# If you deploy the wrapper image at infrastructure/railway/opensearch, these
# are already baked in. If you deploy the raw opensearchproject/opensearch:2.11.1
# image instead, set them here:
# discovery.type=single-node
# bootstrap.memory_lock=false
# node.store.allow_mmap=false
# network.host=::
# DISABLE_SECURITY_PLUGIN=true
# DISABLE_INSTALL_DEMO_CONFIG=true
# OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m


# =============================================================================
# Service: backend
# =============================================================================
OPENSEARCH_URL=http://${{opensearch.RAILWAY_PRIVATE_DOMAIN}}:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin
# JWT — generate with: openssl rand -hex 32
BACKEND_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
BACKEND_JWT_ALGORITHM=HS256
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=60
# CORS — only needed if the browser ever calls the backend directly. With the
# default nginx-proxy setup the browser only talks to the frontend origin.
CORS_ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
# Default users (CHANGE THE PASSWORDS)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=CHANGE_ME_admin_password
DEFAULT_ADMIN_EMAIL=admin@cityshield.example.com
DEFAULT_RESEARCHER_USER=researcher
DEFAULT_RESEARCHER_PASS=CHANGE_ME_researcher_password
DEFAULT_RESEARCHER_EMAIL=researcher@cityshield.example.com
# Cloud-only mode: no Docker socket on Railway, so the live cyber-range / lab
# features are disabled. Keep mock city components on.
USE_MOCK_CITY_COMPONENTS=true
LOG_LEVEL=INFO


# =============================================================================
# Service: frontend   (the only service that needs a public domain for users)
# =============================================================================
# Points the nginx reverse proxy at the backend over the private network.
# ${{backend.PORT}} is the port the backend binds (Railway-assigned).
BACKEND_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}


# =============================================================================
# Service: traffic-sim / iot-sim / network-emulator
# =============================================================================
OPENSEARCH_URL=http://${{opensearch.RAILWAY_PRIVATE_DOMAIN}}:9200
LOG_LEVEL=INFO
# traffic-sim:
TRAFFIC_SIM_EVENT_RATE=2
# iot-sim:
IOT_SIM_EVENT_RATE=3
# network-emulator:
NETWORK_EMULATOR_EVENT_RATE=1


# =============================================================================
# Service: detection-engine
# =============================================================================
OPENSEARCH_URL=http://${{opensearch.RAILWAY_PRIVATE_DOMAIN}}:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin
DETECTION_POLL_INTERVAL_SECONDS=30
DETECTION_QUERY_WINDOW_SECONDS=300
DETECTION_LOOKBACK_MINUTES=10
THREAT_INTEL_PROVIDER=mock
ABUSEIPDB_API_KEY=
LOG_LEVEL=INFO


# =============================================================================
# Service: response-manager
# =============================================================================
OPENSEARCH_URL=http://${{opensearch.RAILWAY_PRIVATE_DOMAIN}}:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin
RESPONSE_POLL_INTERVAL_SECONDS=30
# Ansible/Docker-based active response is not available on Railway. Leave this
# false so the manager records intended actions without trying to run playbooks.
RESPONSE_ENABLED=false
LOG_LEVEL=INFO


# =============================================================================
# Service: scenario-runner
# =============================================================================
OPENSEARCH_URL=http://${{opensearch.RAILWAY_PRIVATE_DOMAIN}}:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin
SCENARIO_POLL_INTERVAL_SECONDS=5
TRAFFIC_SIM_URL=http://${{traffic-sim.RAILWAY_PRIVATE_DOMAIN}}:8001
IOT_SIM_URL=http://${{iot-sim.RAILWAY_PRIVATE_DOMAIN}}:8002
NETWORK_EMULATOR_URL=http://${{network-emulator.RAILWAY_PRIVATE_DOMAIN}}:8003
LOG_LEVEL=INFO
