server {
    # ${PORT} is injected at container start by docker-entrypoint.sh.
    # Defaults to 80 for local docker-compose; Railway/Render set it to their port.
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve upstream names at request time (not startup) so nginx boots even if
    # the backend isn't up yet and survives backend redeploys (new IP).
    # ${NGINX_RESOLVER} is taken from /etc/resolv.conf by the entrypoint.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;

    # Cache-busting: index.html should never be cached
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Hashed assets can be cached forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /ws/ {
        # ${BACKEND_URL} -> http://backend:8000 locally; a private http URL on
        # Railway; or a public https URL on Render. ${BACKEND_HOST} is the bare
        # host[:port], used for the upstream Host header and TLS SNI so HTTPS
        # upstreams (e.g. *.onrender.com) route and negotiate correctly.
        set $cityshield_backend ${BACKEND_URL};
        proxy_pass $cityshield_backend;
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location /api {
        set $cityshield_backend ${BACKEND_URL};
        proxy_pass $cityshield_backend;
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }
}
