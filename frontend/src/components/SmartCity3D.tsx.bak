import { useState, useMemo, useCallback, useEffect, useRef } from 'react'
import { useNavigate } from 'react-router-dom'
import anime from 'animejs'
import { ThreeEvent } from '@react-three/fiber'
import CityScene from './smartcity/CityScene'
import WindmillPanel from './smartcity/WindmillPanel'
import AssetInspectorPanel from './smartcity/AssetInspectorPanel'
import { useAssetStream } from './smartcity/useAssetStream'
import type { CityAsset } from '../types/assets'
import { STATUS_COLORS, CATEGORY_COLORS } from './smartcity/materials'
import type { ActiveAttack } from '../App'

// Zone layout matching Zones.tsx layout
const ZONE_CENTERS: Record<string, [number, number]> = {
  'zone-a': [-8, -8],
  'zone-b': [8, -8],
  'zone-c': [-8, 8],
  'zone-d': [8, 8],
  'zone-e': [0, 0],
}

const COMPONENT_TO_ZONE: Record<string, string> = {
  traffic_management: 'zone-a',
  traffic_sim: 'zone-a',
  iot_sensors: 'zone-b',
  iot_sim: 'zone-b',
  network_infrastructure: 'zone-c',
  network_emulator: 'zone-c',
  security: 'zone-d',
  industrial_systems: 'zone-e',
}

const ZONE_LABELS: Record<string, string> = {
  'zone-a': 'Traffic Management',
  'zone-b': 'IoT Sensors',
  'zone-c': 'Network Infrastructure',
  'zone-d': 'Security Operations',
  'zone-e': 'Industrial Systems',
}

interface AttackPhase {
  name: string
  description: string
}

const ATTACK_PHASES: Record<string, AttackPhase[]> = {
  DDoS: [
    { name: 'Botnet Activation', description: 'Coordinating distributed attack nodes across multiple regions' },
    { name: 'Traffic Flood', description: 'Overwhelming target with SYN/UDP flood packets at high volume' },
    { name: 'Service Degradation', description: 'Target services becoming unresponsive to legitimate requests' },
    { name: 'Full Denial', description: 'Complete service disruption achieved - all endpoints unreachable' },
  ],
  'Brute Force': [
    { name: 'Target Enumeration', description: 'Identifying active login endpoints and valid usernames' },
    { name: 'Credential Spray', description: 'Testing common password combinations across discovered accounts' },
    { name: 'Intensive Attack', description: 'Focused high-rate attempts on viable accounts detected' },
    { name: 'Access Breach', description: 'Valid credentials discovered - unauthorized access gained' },
  ],
  'Port Scan': [
    { name: 'Host Discovery', description: 'Sending ICMP and ARP probes to identify live hosts on the network' },
    { name: 'Port Enumeration', description: 'Scanning TCP/UDP ports 1-65535 on discovered hosts' },
    { name: 'Service Detection', description: 'Fingerprinting detected services and their versions' },
    { name: 'Vulnerability Mapping', description: 'Mapping discovered services against known vulnerability databases' },
  ],
  Malware: [
    { name: 'Initial Delivery', description: 'Malicious payload delivered via compromised firmware update channel' },
    { name: 'Execution', description: 'Payload executing on target device, establishing persistence' },
    { name: 'Lateral Movement', description: 'Spreading to adjacent IoT devices through network protocols' },
    { name: 'Data Exfiltration', description: 'Collecting and transmitting sensitive data to external C2 server' },
  ],
  'Data Exfiltration': [
    { name: 'Access Established', description: 'Attacker gains access to data stores through compromised credentials' },
    { name: 'Data Collection', description: 'Aggregating sensitive data from multiple database tables' },
    { name: 'Staging', description: 'Compressing and encrypting data for covert transmission' },
    { name: 'Exfiltration', description: 'Transmitting data to external server via encrypted DNS tunneling' },
  ],
  'SQL Injection': [
    { name: 'Reconnaissance', description: 'Probing input fields for injection vulnerabilities' },
    { name: 'Exploitation', description: 'Crafting and injecting malicious SQL payloads' },
    { name: 'Data Access', description: 'Extracting database schema and sensitive records' },
    { name: 'Privilege Escalation', description: 'Leveraging DB access to escalate system privileges' },
  ],
}

const DEFAULT_PHASES: AttackPhase[] = [
  { name: 'Reconnaissance', description: 'Scanning target systems for vulnerabilities' },
  { name: 'Initial Access', description: 'Attempting to gain entry into target systems' },
  { name: 'Execution', description: 'Running attack payload on compromised systems' },
  { name: 'Impact', description: 'Affecting target systems and data integrity' },
]

const ATTACK_EXPLANATIONS: Record<string, { why: string; how: string }> = {
  DDoS: {
    why: 'Overwhelm network infrastructure to cause service disruption for city operations. This can disable traffic management, emergency services, and critical communication systems.',
    how: 'A distributed botnet sends massive volumes of SYN/UDP packets to flood target servers, exhausting connection pools and bandwidth until legitimate traffic cannot be processed.',
  },
  'Brute Force': {
    why: 'Gain unauthorized access to traffic management control systems. Compromised credentials could allow manipulation of traffic signals and routing.',
    how: 'Automated tools rapidly test thousands of username/password combinations against authentication endpoints, starting with common defaults and dictionary attacks.',
  },
  'Port Scan': {
    why: 'Map the attack surface of network infrastructure to identify vulnerable services and potential entry points for deeper exploitation.',
    how: 'Network scanning tools send TCP SYN packets to every port on target hosts, analyzing responses to determine which services are running and their versions.',
  },
  Malware: {
    why: 'Compromise IoT sensor devices to manipulate city environmental data, create false readings, or use devices as botnet nodes for further attacks.',
    how: 'Malicious firmware is deployed via a compromised update server, executing arbitrary code on sensor devices that establishes C2 communication channels.',
  },
  'Data Exfiltration': {
    why: 'Steal sensitive city infrastructure data including security configurations, network topologies, and citizen data that could enable further attacks.',
    how: 'After gaining access through compromised accounts, data is collected, compressed, and secretly transmitted via DNS tunneling to evade detection.',
  },
  'SQL Injection': {
    why: 'Access and manipulate databases storing critical infrastructure configurations and operational data.',
    how: 'Specially crafted SQL commands are injected through unvalidated input fields to bypass authentication and directly query database contents.',
  },
}

const ATTACK_ICONS: Record<string, string> = {
  DDoS: '\u{1F30A}',
  'Brute Force': '\u{1F528}',
  'Port Scan': '\u{1F50D}',
  Malware: '\u{1F9A0}',
  'Data Exfiltration': '\u{1F4E4}',
  'SQL Injection': '\u{1F489}',
}

interface StageData {
  name: string
  description: string
  status: string
  started_at: string | null
  completed_at: string | null
  error: string | null
}

interface StageResponse {
  run_id: string
  status: string
  target_device_id: string | null
  target_component_id: string | null
  stages: StageData[]
}

interface SmartCity3DProps {
  activeAttack?: ActiveAttack | null
  onAttackEnd?: () => void
}

export default function SmartCity3D({ activeAttack, onAttackEnd }: SmartCity3DProps) {
  const { assets, attackPaths, connected, error } = useAssetStream()
  const [selectedId, setSelectedId] = useState<string | null>(null)
  const [hoveredComponent, setHoveredComponent] = useState<CityAsset | null>(null)
  const [tooltipPos, setTooltipPos] = useState<{ x: number; y: number }>({ x: 0, y: 0 })
  const detailsRef = useRef<HTMLDivElement>(null)
  const attackPanelRef = useRef<HTMLDivElement>(null)
  const navigate = useNavigate()

  // Attack progress state
  const [attackProgress, setAttackProgress] = useState(0)
  const [attackComplete, setAttackComplete] = useState(false)

  // Stage polling state
  const [stageData, setStageData] = useState<StageResponse | null>(null)
  const [attackedBuildingId, setAttackedBuildingId] = useState<string | null>(null)

  // Windmill state
  const [windmillState, setWindmillState] = useState({
    rpm: 12, temperature: 45, powerOutput: 280, isHacked: false
  })
  const [showWindmillPanel, setShowWindmillPanel] = useState(false)

  // Windmill hack effect — gradually increases rpm and temp
  useEffect(() => {
    if (!windmillState.isHacked) return
    const interval = setInterval(() => {
      setWindmillState(prev => {
        if (!prev.isHacked) return prev
        return {
          ...prev,
          rpm: Math.min(prev.rpm + 0.5, 35),
          temperature: Math.min(prev.temperature + 2, 130),
          powerOutput: Math.min(prev.powerOutput + 5, 600),
        }
      })
    }, 500)
    return () => clearInterval(interval)
  }, [windmillState.isHacked])

  // Animate details panel on selection change
  useEffect(() => {
    if (selectedId && detailsRef.current) {
      anime({
        targets: detailsRef.current,
        translateX: [30, 0],
        opacity: [0, 1],
        duration: 400,
        easing: 'easeOutCubic',
      })
    }
  }, [selectedId])

  // Animate attack panel on mount
  useEffect(() => {
    if (activeAttack && attackPanelRef.current) {
      anime({
        targets: attackPanelRef.current,
        translateX: [-40, 0],
        opacity: [0, 1],
        duration: 500,
        easing: 'easeOutCubic',
      })
    }
    if (!activeAttack) {
      setAttackProgress(0)
      setAttackComplete(false)
      setStageData(null)
      setAttackedBuildingId(null)
    }
  }, [activeAttack])

  // Attack progress timer
  useEffect(() => {
    if (!activeAttack) return

    const startTime = new Date(activeAttack.startedAt).getTime()
    const duration = activeAttack.durationSeconds * 1000

    const interval = setInterval(() => {
      const elapsed = Date.now() - startTime
      const progress = Math.min(elapsed / duration, 1)
      setAttackProgress(progress)

      if (progress >= 1) {
        setAttackComplete(true)
        clearInterval(interval)
      }
    }, 100)

    return () => clearInterval(interval)
  }, [activeAttack])

  // Poll stages endpoint during active attack
  useEffect(() => {
    if (!activeAttack) return

    const fetchStages = async () => {
      try {
        const token = localStorage.getItem('token')
        const res = await fetch(`/api/scenarios/runs/${activeAttack.runId}/stages`, {
          headers: { 'Authorization': `Bearer ${token}` }
        })
        if (res.ok) {
          const data: StageResponse = await res.json()
          setStageData(data)
          // Set attacked building from target_component_id
          if (data.target_component_id) {
            setAttackedBuildingId(data.target_component_id)
          }
          // Check if run is completed from server
          if (data.status === 'completed' || data.status === 'failed') {
            setAttackComplete(true)
          }
        }
      } catch (e) {
        // Silently fail
      }
    }

    fetchStages()
    const interval = setInterval(fetchStages, 2000)
    return () => clearInterval(interval)
  }, [activeAttack])

  const selectedComponent = useMemo(
    () => assets.find((c) => c.id === selectedId) || null,
    [assets, selectedId]
  )

  // Focus on attacked zone when attack starts
  const attackZone = activeAttack ? COMPONENT_TO_ZONE[activeAttack.targetComponent] || null : null

  const focusPosition = useMemo<[number, number, number] | null>(() => {
    if (attackZone) {
      const center = ZONE_CENTERS[attackZone]
      if (center) return [center[0], 1.5, center[1]]
    }
    if (!selectedComponent) return null
    const zone = selectedComponent.zone || 'zone-a'
    const center = ZONE_CENTERS[zone] || [0, 0]
    return [center[0], 1.5, center[1]]
  }, [selectedComponent, attackZone])

  const handleSelect = useCallback((id: string | null) => {
    setSelectedId(id)
  }, [])

  const handleHover = useCallback((comp: CityAsset | null, event?: ThreeEvent<PointerEvent>) => {
    setHoveredComponent(comp)
    if (event && comp) {
      const nativeEvent = event.nativeEvent || (event as any)
      if (nativeEvent && typeof nativeEvent.clientX === 'number') {
        setTooltipPos({ x: nativeEvent.clientX, y: nativeEvent.clientY })
      }
    }
  }, [])

  // Summary stats
  const stats = useMemo(() => {
    const total = assets.length
    const critical = assets.filter((c) => c.status === 'critical').length
    const warning = assets.filter((c) => c.status === 'warning').length
    const ok = assets.filter((c) => c.status === 'ok').length
    const offline = assets.filter((c) => c.status === 'offline').length
    return { total, critical, warning, ok, offline }
  }, [assets])

  // Determine phases: use real stage data if available, fallback to time-based
  const hasRealStages = stageData && stageData.stages && stageData.stages.length > 0
  const phases = activeAttack
    ? (hasRealStages
        ? stageData!.stages.map(s => ({ name: s.name, description: s.description }))
        : ATTACK_PHASES[activeAttack.attackPattern] || DEFAULT_PHASES)
    : []

  // Determine current phase index from real stage data or time-based
  const currentPhaseIndex = activeAttack
    ? (hasRealStages
        ? stageData!.stages.findIndex(s => s.status === 'running')
        : Math.min(Math.floor(attackProgress * 4), 3))
    : -1

  const explanation = activeAttack
    ? ATTACK_EXPLANATIONS[activeAttack.attackPattern] || { why: 'Attempting to compromise city infrastructure systems.', how: 'Using known attack techniques against target systems.' }
    : null
  const attackIcon = activeAttack ? ATTACK_ICONS[activeAttack.attackPattern] || '\u{26A0}\u{FE0F}' : ''

  const activeContainerStyle: React.CSSProperties = {
    ...containerStyle,
    ...(activeAttack && !attackComplete ? {
      border: '2px solid var(--accent-danger)',
      animation: 'attack-pulse 2s infinite',
    } : {}),
  }

  if (error) {
    return (
      <div style={containerStyle}>
        <div style={{ padding: '2rem', textAlign: 'center', color: 'var(--accent-danger)' }}>
          Failed to load city data: {error}
        </div>
      </div>
    )
  }

  return (
    <div style={activeContainerStyle}>
      {/* 3D Canvas */}
      <div style={{ position: 'relative', width: '100%', height: '100%' }}>
        <CityScene
          assets={assets}
          selectedId={selectedId}
          attackedBuildingId={attackComplete ? null : attackedBuildingId}
          attackPaths={attackPaths}
          onSelect={handleSelect}
          onHover={handleHover}
          focusPosition={focusPosition}
          windmillRpm={windmillState.rpm}
          windmillTemperature={windmillState.temperature}
          windmillHacked={windmillState.isHacked}
          onWindmillInteract={() => setShowWindmillPanel(prev => !prev)}
          trainHacked={windmillState.isHacked}
        />

        {/* Windmill Panel */}
        {showWindmillPanel && !activeAttack && (
          <WindmillPanel
            state={windmillState}
            onStateChange={setWindmillState}
            onClose={() => setShowWindmillPanel(false)}
          />
        )}

        {/* Attack Visualization Overlay */}
        {activeAttack && (
          <div ref={attackPanelRef} style={attackPanelStyle}>
            {/* Header */}
            <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '0.75rem' }}>
              <span style={{ fontSize: '1.3rem' }}>{attackIcon}</span>
              <div style={{ flex: 1 }}>
                <div style={{ fontWeight: 700, fontSize: '0.85rem', color: 'var(--accent-danger)' }}>
                  {attackComplete ? 'ATTACK COMPLETE' : 'ATTACK IN PROGRESS'}
                </div>
                <div style={{ fontSize: '0.75rem', color: 'var(--text-secondary)' }}>
                  {activeAttack.scenarioName}
                </div>
              </div>
              {attackComplete && (
                <button
                  onClick={onAttackEnd}
                  style={{
                    background: 'none',
                    border: 'none',
                    color: 'var(--text-tertiary)',
                    cursor: 'pointer',
                    fontSize: '1rem',
                    padding: '0 0.25rem',
                    lineHeight: 1,
                  }}
                >
                  x
                </button>
              )}
            </div>

            {/* Progress Bar */}
            <div style={{ marginBottom: '0.75rem' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '0.25rem' }}>
                <span style={{ fontSize: '0.65rem', color: 'var(--text-tertiary)', textTransform: 'uppercase', letterSpacing: '0.05em' }}>
                  Progress
                </span>
                <span style={{ fontSize: '0.7rem', color: 'var(--text-secondary)', fontFamily: 'monospace' }}>
                  {Math.round(attackProgress * 100)}%
                </span>
              </div>
              <div style={{
                height: '4px',
                borderRadius: '2px',
                background: 'rgba(239, 68, 68, 0.15)',
                overflow: 'hidden',
              }}>
                <div style={{
                  height: '100%',
                  width: `${attackProgress * 100}%`,
                  borderRadius: '2px',
                  background: attackComplete
                    ? 'var(--accent-success)'
                    : 'linear-gradient(90deg, var(--accent-danger), #ff6b6b)',
                  transition: 'width 0.1s linear',
                  animation: attackComplete ? 'none' : 'progress-glow 1.5s infinite',
                }} />
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: '0.2rem' }}>
                <span style={{ fontSize: '0.6rem', color: 'var(--text-tertiary)' }}>
                  {activeAttack.attackPattern}
                </span>
                <span style={{ fontSize: '0.6rem', color: 'var(--text-tertiary)' }}>
                  {attackComplete ? 'Done' : `${Math.max(0, Math.round(activeAttack.durationSeconds * (1 - attackProgress)))}s left`}
                </span>
              </div>
            </div>

            {/* Target Info */}
            <div style={{
              background: 'rgba(239, 68, 68, 0.08)',
              border: '1px solid rgba(239, 68, 68, 0.2)',
              borderRadius: '0.375rem',
              padding: '0.5rem',
              marginBottom: '0.75rem',
              fontSize: '0.7rem',
            }}>
              <div style={{ color: 'var(--text-tertiary)', marginBottom: '0.2rem' }}>Target</div>
              <div style={{ color: 'var(--accent-danger)', fontWeight: 600 }}>
                {attackedBuildingId || (attackZone ? ZONE_LABELS[attackZone] : activeAttack.targetComponent)}
                {attackZone && <span style={{ color: 'var(--text-tertiary)', fontWeight: 400 }}> ({attackZone})</span>}
              </div>
            </div>

            {/* Attack Phases Timeline */}
            <div style={{ marginBottom: '0.75rem' }}>
              <div style={{ fontSize: '0.65rem', color: 'var(--text-tertiary)', textTransform: 'uppercase', letterSpacing: '0.05em', marginBottom: '0.5rem' }}>
                Attack Phases
              </div>
              {phases.map((phase, i) => {
                // Real stage data status
                const realStage = hasRealStages ? stageData!.stages[i] : null
                const stageStatus = realStage?.status
                const isActive = hasRealStages ? stageStatus === 'running' : i === currentPhaseIndex
                const isDone = hasRealStages
                  ? (stageStatus === 'success')
                  : (i < currentPhaseIndex || attackComplete)
                const isFailed = hasRealStages ? stageStatus === 'failed' : false

                // Phase indicator icon
                let indicatorContent = ''
                let borderColor = 'var(--border-color)'
                let bgColor = 'transparent'
                if (isDone) {
                  indicatorContent = '\u2713'
                  borderColor = 'var(--accent-success)'
                  bgColor = 'var(--accent-success)'
                } else if (isFailed) {
                  indicatorContent = '\u2717'
                  borderColor = 'var(--accent-danger)'
                  bgColor = 'var(--accent-danger)'
                } else if (isActive) {
                  indicatorContent = ''
                  borderColor = 'var(--accent-danger)'
                  bgColor = 'rgba(239, 68, 68, 0.3)'
                }

                return (
                  <div key={i} style={{ display: 'flex', gap: '0.5rem', marginBottom: '0.4rem' }}>
                    <div style={{
                      width: 16,
                      height: 16,
                      borderRadius: '50%',
                      border: `2px solid ${borderColor}`,
                      background: bgColor,
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      fontSize: '0.5rem',
                      color: 'white',
                      flexShrink: 0,
                      marginTop: '1px',
                      animation: isActive ? 'pulse-border 1s infinite' : 'none',
                    }}>
                      {indicatorContent}
                    </div>
                    <div style={{ flex: 1 }}>
                      <div style={{
                        fontSize: '0.72rem',
                        fontWeight: isActive ? 700 : 500,
                        color: isDone ? 'var(--accent-success)' : isFailed ? 'var(--accent-danger)' : isActive ? 'var(--accent-danger)' : 'var(--text-tertiary)',
                      }}>
                        {phase.name}
                      </div>
                      {(isActive || isDone || isFailed) && (
                        <div style={{ fontSize: '0.62rem', color: 'var(--text-tertiary)', marginTop: '0.1rem' }}>
                          {isFailed && realStage?.error ? realStage.error : phase.description}
                        </div>
                      )}
                    </div>
                  </div>
                )
              })}
            </div>

            {/* Why & How */}
            {explanation && (
              <div style={{ marginBottom: '0.75rem' }}>
                <div style={{
                  background: 'rgba(59, 130, 246, 0.08)',
                  border: '1px solid rgba(59, 130, 246, 0.15)',
                  borderRadius: '0.375rem',
                  padding: '0.5rem',
                  marginBottom: '0.4rem',
                }}>
                  <div style={{ fontSize: '0.62rem', color: 'var(--accent-primary)', fontWeight: 600, textTransform: 'uppercase', marginBottom: '0.2rem' }}>
                    Why this attack
                  </div>
                  <div style={{ fontSize: '0.65rem', color: 'var(--text-secondary)', lineHeight: 1.4 }}>
                    {explanation.why}
                  </div>
                </div>
                <div style={{
                  background: 'rgba(139, 92, 246, 0.08)',
                  border: '1px solid rgba(139, 92, 246, 0.15)',
                  borderRadius: '0.375rem',
                  padding: '0.5rem',
                }}>
                  <div style={{ fontSize: '0.62rem', color: 'var(--accent-secondary)', fontWeight: 600, textTransform: 'uppercase', marginBottom: '0.2rem' }}>
                    How it works
                  </div>
                  <div style={{ fontSize: '0.65rem', color: 'var(--text-secondary)', lineHeight: 1.4 }}>
                    {explanation.how}
                  </div>
                </div>
              </div>
            )}

            {/* Completion Actions */}
            {attackComplete && (
              <div style={{ display: 'flex', gap: '0.5rem' }}>
                <button
                  className="btn btn-danger btn-sm"
                  style={{ flex: 1, fontSize: '0.75rem', justifyContent: 'center' }}
                  onClick={() => navigate('/alerts')}
                >
                  View Alerts
                </button>
                <button
                  className="btn btn-secondary btn-sm"
                  style={{ flex: 1, fontSize: '0.75rem', justifyContent: 'center' }}
                  onClick={onAttackEnd}
                >
                  Dismiss
                </button>
              </div>
            )}
          </div>
        )}

        {/* Zone legend overlay */}
        <div style={legendStyle}>
          <div style={legendTitle}>City Zones</div>
          {[
            { label: 'Traffic', color: CATEGORY_COLORS.traffic, zone: 'zone-a' },
            { label: 'IoT', color: CATEGORY_COLORS.iot, zone: 'zone-b' },
            { label: 'Network', color: CATEGORY_COLORS.network, zone: 'zone-c' },
            { label: 'Security', color: CATEGORY_COLORS.security, zone: 'zone-d' },
            { label: 'Industrial', color: CATEGORY_COLORS.industrial, zone: 'zone-e' },
          ].map(({ label, color, zone }) => {
            const count = assets.filter((c) => c.zone === zone).length
            const isUnderAttack = attackZone === zone && !attackComplete
            return (
              <div key={zone} style={{ ...legendItem, ...(isUnderAttack ? { color: 'var(--accent-danger)' } : {}) }}>
                <div style={{
                  width: 10,
                  height: 10,
                  borderRadius: 2,
                  background: isUnderAttack ? 'var(--accent-danger)' : color,
                  animation: isUnderAttack ? 'pulse-border 1.5s infinite' : 'none',
                }} />
                <span style={{
                  color: isUnderAttack ? 'var(--accent-danger)' : 'var(--text-secondary)',
                  fontSize: '0.75rem',
                  fontWeight: isUnderAttack ? 600 : 400,
                }}>
                  {label} ({count}) {isUnderAttack ? '- UNDER ATTACK' : ''}
                </span>
              </div>
            )
          })}
          <div style={{ marginTop: '0.5rem', borderTop: '1px solid var(--border-color)', paddingTop: '0.5rem' }}>
            <div style={legendTitle}>Status</div>
            {[
              { label: 'OK', color: STATUS_COLORS.ok, count: stats.ok },
              { label: 'Warning', color: STATUS_COLORS.warning, count: stats.warning },
              { label: 'Critical', color: STATUS_COLORS.critical, count: stats.critical },
              { label: 'Offline', color: STATUS_COLORS.offline, count: stats.offline },
            ].map(({ label, color, count }) => (
              <div key={label} style={legendItem}>
                <div style={{ width: 10, height: 10, borderRadius: 2, background: color }} />
                <span style={{ color: 'var(--text-secondary)', fontSize: '0.75rem' }}>
                  {label} ({count})
                </span>
              </div>
            ))}
          </div>
        </div>

        {/* Component count badge */}
        <div style={badgeStyle}>
          {stats.total} Components
        </div>

        {/* Hover tooltip */}
        {hoveredComponent && (
          <div
            style={{
              position: 'fixed',
              left: tooltipPos.x + 15,
              top: tooltipPos.y - 10,
              background: 'var(--bg-card)',
              border: '1px solid var(--border-color)',
              borderRadius: '0.5rem',
              padding: '0.5rem 0.75rem',
              pointerEvents: 'none',
              zIndex: 1000,
              minWidth: '160px',
              boxShadow: 'var(--shadow-lg)',
            }}
          >
            <div style={{ fontWeight: 600, fontSize: '0.8rem', color: 'var(--text-primary)', marginBottom: '0.25rem' }}>
              {hoveredComponent.name}
            </div>
            <div style={{ display: 'flex', alignItems: 'center', gap: '0.375rem', fontSize: '0.7rem' }}>
              <span
                style={{
                  display: 'inline-block',
                  width: 8,
                  height: 8,
                  borderRadius: '50%',
                  background: STATUS_COLORS[hoveredComponent.status],
                }}
              />
              <span style={{ color: 'var(--text-secondary)', textTransform: 'capitalize' }}>
                {hoveredComponent.status}
              </span>
            </div>
            <div style={{ fontSize: '0.7rem', color: 'var(--text-tertiary)', marginTop: '0.2rem' }}>
              {hoveredComponent.eventsCount} events | {hoveredComponent.alertsCount} alerts
            </div>
          </div>
        )}

        {/* SOC-Grade Asset Inspector Panel (HighTopo-equivalent) */}
        {selectedComponent && !activeAttack && !showWindmillPanel && (
          <AssetInspectorPanel
            asset={selectedComponent}
            onClose={() => setSelectedId(null)}
          />
        )}
      </div>
    </div>
  )
}

// Styles
