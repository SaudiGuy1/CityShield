# OpenSearch Configuration
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=Admin@123!Change
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Admin@123!Change

# Backend Configuration
BACKEND_JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
BACKEND_JWT_ALGORITHM=HS256
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default Admin User (CHANGE AFTER FIRST LOGIN)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=CityShield@Admin2026
DEFAULT_ADMIN_EMAIL=admin@cityshield.example.com

# Default Researcher User (CHANGE AFTER FIRST LOGIN)
DEFAULT_RESEARCHER_USER=researcher
DEFAULT_RESEARCHER_PASS=CityShield@Researcher2026
DEFAULT_RESEARCHER_EMAIL=researcher@cityshield.example.com

# Threat Intelligence
ABUSEIPDB_API_KEY=
THREAT_INTEL_PROVIDER=mock

# Detection Engine Configuration
DETECTION_POLL_INTERVAL_SECONDS=30
DETECTION_QUERY_WINDOW_SECONDS=300
DETECTION_LOOKBACK_MINUTES=10

# Response Manager Configuration
RESPONSE_POLL_INTERVAL_SECONDS=30
RESPONSE_ENABLED=true

# Scenario Runner Configuration
SCENARIO_POLL_INTERVAL_SECONDS=5

# Rule Thresholds
RULE_NET_SCAN_THRESHOLD=10
RULE_IOT_ANOMALY_THRESHOLD=5

# Simulator Configuration
TRAFFIC_SIM_EVENT_RATE=2
IOT_SIM_EVENT_RATE=3
NETWORK_EMULATOR_EVENT_RATE=1

# 3D City Visualization
USE_MOCK_CITY_COMPONENTS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Docker Network
CITYSHIELD_NETWORK=cityshield_network

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601
